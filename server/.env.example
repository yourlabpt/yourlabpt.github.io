# Server
PORT=3000
ADMIN_PASSWORD=yourlab-admin

# Digitalize Portugal — sales app master key (shared with whoever is out selling)
DIGITALIZEPT_KEY=digitalizept-key

# Coverage map uses OpenStreetMap (Leaflet + Nominatim). No Google key required.
# GOOGLE_MAPS_API_KEY is unused.

# IVA rate as a fraction. 0.23 = taxa normal, 0 = regime de isenção (art. 53.º CIVA).
# At 0 no IVA is charged and the contract prints the isenção note instead.
DIGITALIZEPT_IVA_RATE=0.23

# Prestador fiscal identity — printed on every contract. NIF and morada are
# required for a contract to be valid; leaving them empty shows "(em falta)".
YOURLAB_NOME=YourLab
YOURLAB_RESPONSAVEL=Túlio Soares
YOURLAB_NIF=
YOURLAB_MORADA=
YOURLAB_EMAIL=yourlabpt@gmail.com
YOURLAB_TELEFONE=+351936732879
YOURLAB_SITE=yourlabpt.com
# Payment details printed in the contract so the client can pay the entrada
YOURLAB_IBAN=
# Optional Chrome/Chromium path for contract PDFs. Leave empty to use the
# Chromium that Puppeteer installs with the server (recommended).
DIGITALIZEPT_CHROME_PATH=

# Chat mode
# - auto: try local models first, fallback to offline lead bot when needed
# - offline: force offline lead bot only (no model calls)
CHAT_MODE=auto

# Local model settings (used only when CHAT_MODE=auto)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_SMALL=phi3:mini
OLLAMA_MODEL_BIG=llama3.1:8b
SMALL_MODEL_TURNS=2
MODEL_TIMEOUT_MS=30000
STICKY_JS_FALLBACK=true
MAX_AI_TURNS_WITHOUT_CONTACT=8

# Session
CHAT_SESSION_TTL_MS=2700000

# Lead notifications — only SMTP_PASS (Gmail app password) has to be filled in
LEAD_NOTIFY_TO=yourlabpt@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourlabpt@gmail.com
SMTP_PASS=
SMTP_FROM=YourLab <yourlabpt@gmail.com>

# Optional CORS extras (comma-separated)
ALLOWED_ORIGIN=

# Agent execution: local_push for development, remote_pull for hosted production.
# remote_pull is provider-neutral and does not use the URL or secrets below.
AGENT_CONNECTION_MODE=local_push
# local_push only: origin must resolve to localhost, 127.0.0.1, or ::1.
AGENT_RUNTIME_URL=http://127.0.0.1:3847
AGENT_RUNTIME_API_KEY=
AGENT_HMAC_SECRET=
PLATFORM_SERVICE_TOKEN=
# YAR uses this to fetch project context (defaults to http://127.0.0.1:3000)
PLATFORM_BASE_URL=http://127.0.0.1:3000
